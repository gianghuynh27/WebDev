// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id        String @id @default(uuid())
  email     String @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MetaComp {
  id                  String   @id @default(uuid())
  name                String
  tier                String
  difficulty          String
  type                String
  plannerUrl          String?
  avgPlacement        Float?
  top4Rate            Float?
  winRate             Float?
  playRate            Float?
  units               Json
  recommendedAugments Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model RiotMatch {
  id          String   @id
  gameVersion String?
  gameDatetime BigInt?
  queueId      Int?
  raw         Json
  createdAt   DateTime @default(now())
}

model StaticChampion {
  id        String   @id
  name      String
  cost      Int
  traits    Json
  imageUrl  String?
  setNumber Int?
  updatedAt DateTime @updatedAt
}

model StaticItem {
  id        String   @id
  name      String
  imageUrl  String?
  setNumber Int?
  updatedAt DateTime @updatedAt
}

model StaticAugment {
  id          String   @id
  name        String
  imageUrl    String?
  tier        String?
  description String?
  setNumber   Int?
  updatedAt   DateTime @updatedAt
}

model StaticTrait {
  id          String   @id
  name        String
  breakpoints Json
  imageUrl    String?
  setNumber   Int?
  updatedAt   DateTime @updatedAt
}

model ChampionStat {
  id             String   @id @default(uuid())
  championId     String   @unique
  rank           String
  games          Int
  totalPlacement Int
  top4Count      Int
  winCount       Int
  avgPlacement   Float
  top4Rate       Float
  winRate        Float
  updatedAt      DateTime @updatedAt
}

model ItemStat {
  id             String   @id @default(uuid())
  itemId         String   @unique
  rank           String
  games          Int
  totalPlacement Int
  top4Count      Int
  winCount       Int
  avgPlacement   Float
  top4Rate       Float
  winRate        Float
  updatedAt      DateTime @updatedAt
}

model AugmentStat {
  id             String   @id @default(uuid())
  augmentId      String   @unique
  rank           String
  games          Int
  totalPlacement Int
  top4Count      Int
  winCount       Int
  avgPlacement   Float
  top4Rate       Float
  winRate        Float
  updatedAt      DateTime @updatedAt
}